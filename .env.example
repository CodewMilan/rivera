# Postgres. In production, use the pooled connection string (sslmode=require).
# Neon / Supabase / Vercel Postgres all work.
DATABASE_URL=
RIVERA_STORE=postgres

# Public origin. Set this to the deployed URL, e.g. https://rivera.example.com.
# On Vercel this falls back to https://$VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=

# AES-256-GCM key used to encrypt user-supplied secrets at rest (Cursor API
# keys, GitHub tokens). Generate with:  openssl rand -hex 32
# In production this MUST be set. Losing it invalidates every stored secret.
RIVERA_SECRET_KEY=

# Clerk: keys come from `npx clerk@latest init`. Never commit secrets.
# Production needs a Clerk production instance with the deploy domain allowlisted.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Live LLM (OpenAI-compatible). Leave empty to use labeled demo fixtures.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Higgsfield: server-side only
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_WEBHOOK_SECRET=
HIGGSFIELD_WEBHOOK_URL=
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai

# Optional tools
TAVILY_API_KEY=
GITHUB_TOKEN=

# GitHub OAuth (Development tab / Cursor cloud handoff).
# Create an OAuth app at https://github.com/settings/developers with
# Authorization callback URL:  {APP_URL}/api/github/callback
# Request scopes are `repo` and `read:user` (set by the app automatically).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional override; defaults to {APP_URL}/api/github/callback.
GITHUB_OAUTH_REDIRECT_URI=

# Cursor Cloud Agents. Users mint their own key at cursor.com/dashboard/api
# and connect it from the Development tab. Rivera never stores its own key.
# Override the base only for staging environments.
CURSOR_API_BASE=https://api.cursor.com

# Gmail: read-only inbox scan. Create an OAuth client in Google Cloud,
# enable the Gmail API, and add {APP_URL}/api/gmail/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# X / Twitter publish path
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional: copy completed Higgsfield files into S3 so previews outlive provider URLs.
# Leave empty locally. IAM user needs s3:PutObject on s3://$S3_BUCKET/orgs/*.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional CloudFront (or custom) origin. Empty = virtual-hosted S3 URL.
S3_PUBLIC_BASE_URL=

DEMO_MODE=false
AUTO_PUBLISH=false

# Production only: allow the in-memory store (data dies on every cold start).
ALLOW_MEMORY_STORE=false
