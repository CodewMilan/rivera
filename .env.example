DATABASE_URL=postgres://milan@localhost/rivera
RIVERA_STORE=postgres

# Public origin used for Higgsfield webhooks when HIGGSFIELD_WEBHOOK_URL is empty.
# On Vercel this falls back to https://$VERCEL_URL.
APP_URL=http://localhost:3000

# Clerk: keys come from `npx clerk@latest init` / `.env.local`. Never commit secrets.
# Production needs a Clerk production instance and this domain on the allowlist.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Live LLM (OpenAI-compatible). Leave empty to use labeled demo fixtures.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Higgsfield: server-side only
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_WEBHOOK_SECRET=
HIGGSFIELD_WEBHOOK_URL=
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai

# Optional tools
TAVILY_API_KEY=
GITHUB_TOKEN=

# GitHub OAuth (Development tab). Create an OAuth app at
# https://github.com/settings/developers with callback {APP_URL}/api/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=

# Cursor Cloud Agents API base. Override only if pointing at a staging environment.
# The user's Cursor API key is provided per-organization from the Development tab.
CURSOR_API_BASE=https://api.cursor.com

# Gmail: read-only inbox scan. Create an OAuth client in Google Cloud,
# enable the Gmail API, and add {APP_URL}/api/gmail/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# X / Twitter publish path
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

DEMO_MODE=false
AUTO_PUBLISH=false

# Production only: allow the in-memory store (data dies on every cold start).
ALLOW_MEMORY_STORE=false
